# and too large to distribute.
hydrology/data/raw/

# Regenerated hydrology reports and metadata; the versioned calibration output is
# hydrology/outputs/hydro_calibration.json.
hydrology/outputs/*.md
hydrology/metadata/

# Julia local state
LocalPreferences.toml
hpc/logs/
