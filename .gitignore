# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Operating system
.DS_Store
Thumbs.db

# Generated outputs: regenerated from results/<CC>.json by the analysis scripts.
figures/
tables/

# Per-scenario solver output: bundled into results/<CC>.json by
